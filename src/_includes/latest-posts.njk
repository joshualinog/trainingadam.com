{% set defaultImage = 'https://github.com/user-attachments/assets/3fc088e1-139e-4fe5-a0bf-e0567589c96f' %}
{% set topPosts = [posts[0], posts[1]] %}
{% set bottomPosts = [posts[2], posts[3], posts[4] if posts[4] else posts[3]] %}
<div id="latest-posts" class="bg-cotton-candy-500 py-24 sm:py-32 ">
  <div class="mx-auto px-6 lg:px-8">
    <h2 class="text-2xl sm:text-3xl font-subheading font-semibold text-seagrass-700 ">The Training Adam Blog!</h2>
    <p class="mt-2 max-w-lg text-5xl font-heading font-semibold tracking-tight text-pretty text-mauve-shadow-500 sm:text-8xl  uppercase">Latest Blog Content</p>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 md:grid-cols-6 md:grid-rows-2">

      {% for post in topPosts %}
        {% if loop.first %}
          {% set outerRounding = "max-md:rounded-t-4xl md:rounded-tl-4xl" %}
          {% set innerRounding = "max-md:rounded-t-[calc(2rem+1px)] md:rounded-tl-[calc(2rem+1px)]" %}
          {% set imgAlign = "object-left" %}
        {% else %}
          {% set outerRounding = "md:rounded-tr-4xl" %}
          {% set innerRounding = "md:rounded-tr-[calc(2rem+1px)]" %}
          {% set imgAlign = "object-left md:object-right" %}
        {% endif %}
        <div class="relative md:col-span-3">
          <div class="absolute inset-0 rounded-lg bg-blazing-flame-500 {{ outerRounding }}"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] {{ innerRounding }}">
            <img src="{{ post.data.mainImage | default(defaultImage, true) }}" alt="{{ post.data.title }}" class="h-80 object-cover {{ imgAlign }} hidden" />
            <img src="{{ post.data.mainImage | default(defaultImage, true) }}" alt="{{ post.data.title }}" class="h-80 object-cover {{ imgAlign }} not-hidden" />
            <div class="p-10 pt-4 flex flex-col flex-1">
              <h3 class="text-base uppercase font-hand font-semibold text-mauve-shadow-500">{{ post.data.labels | default([]) | join(', ') }}</h3>
              <a href="{{ post.url }}" class="mt-2 text-4xl font-medium tracking-tight text-glowyellowgreen-500 uppercase font-heading">{{ post.data.title }}</a>
              <p class="mt-2 max-w-lg text-3xl font-bold font-heading text-night-bordeaux-500">{{ post.data.contentHtml | striptags | truncate(100) }}</p>
              <a href="{{ post.url }}" class="mt-auto mx-auto inline-block rounded-md bg-mauve-shadow-500 px-6 py-2 font-heading font-semibold uppercase text-cotton-candy-500 hover:bg-seagrass-700 transition-colors text-3xl">Read this!</a>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-0 rounded-lg shadow-sm outline outline-black/5 {{ outerRounding }} outline-white/15"></div>
        </div>
      {% endfor %}

      {% for post in bottomPosts %}
        {% if loop.first %}
          {% set outerRounding = "md:rounded-bl-4xl" %}
          {% set innerRounding = "md:rounded-bl-[calc(2rem+1px)]" %}
          {% set imgAlign = "object-left" %}
        {% elif loop.last %}
          {% set outerRounding = "max-md:rounded-b-4xl md:rounded-br-4xl" %}
          {% set innerRounding = "max-md:rounded-b-[calc(2rem+1px)] md:rounded-br-[calc(2rem+1px)]" %}
          {% set imgAlign = "" %}
        {% else %}
          {% set outerRounding = "" %}
          {% set innerRounding = "" %}
          {% set imgAlign = "" %}
        {% endif %}
        <div class="relative md:col-span-2">
          <div class="absolute inset-0 rounded-lg bg-blazing-flame-500 {{ outerRounding }}"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] {{ innerRounding }}">
            <img src="{{ post.data.mainImage | default(defaultImage, true) }}" alt="{{ post.data.title }}" class="h-80 object-cover {{ imgAlign }} hidden" />
            <img src="{{ post.data.mainImage | default(defaultImage, true) }}" alt="{{ post.data.title }}" class="h-80 object-cover {{ imgAlign }} not-hidden" />
            <div class="p-10 pt-4 flex flex-col flex-1">
              <h3 class="text-base uppercase font-hand font-semibold text-mauve-shadow-500">{{ post.data.labels | default([]) | join(', ') }}</h3>
              <a href="{{ post.url }}" class="mt-2 text-2xl font-medium tracking-tight text-glowyellowgreen-500 uppercase font-heading">{{ post.data.title }}</a>
              <p class="mt-2 max-w-lg text-lg font-bold font-heading text-night-bordeaux-500">{{ post.data.contentHtml | striptags | truncate(100) }}</p>
              <a href="{{ post.url }}" class="mt-auto mx-auto inline-block rounded-md bg-mauve-shadow-500 px-6 py-2 font-heading font-semibold uppercase text-cotton-candy-500 hover:bg-seagrass-700 transition-colors">Read this!</a>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-0 rounded-lg shadow-sm outline outline-black/5 {{ outerRounding }} outline-white/15"></div>
        </div>
      {% endfor %}

    </div>
    <div class="mt-10 flex justify-center">
      <a href="/blog/" class="inline-flex items-center gap-2 rounded-md bg-seagrass-700 px-8 py-3 text-4xl font-heading font-semibold uppercase text-cotton-candy-500 transition-colors hover:bg-seagrass-700">
        See More Posts
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
          <path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</div>