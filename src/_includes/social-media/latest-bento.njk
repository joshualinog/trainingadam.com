{% if platformPosts and platformPosts.length %}

{#
  Per-cell config arrays (indexed 0–4 by loop.index0).
  Tailwind v4 @source inline(...) already safelists all custom color classes,
  and the literal strings below are picked up by the content scanner.
#}
{% set bentoSpan        = ["md:col-span-3", "md:col-span-3", "md:col-span-2", "md:col-span-2", "md:col-span-2"] %}
{% set bentoOuterRound  = ["max-md:rounded-t-4xl md:rounded-tl-4xl", "md:rounded-tr-4xl", "md:rounded-bl-4xl", "", "max-md:rounded-b-4xl md:rounded-br-4xl"] %}
{% set bentoInnerRound  = ["max-md:rounded-t-[calc(2rem+1px)] md:rounded-tl-[calc(2rem+1px)]", "md:rounded-tr-[calc(2rem+1px)]", "md:rounded-bl-[calc(2rem+1px)]", "", "max-md:rounded-b-[calc(2rem+1px)] md:rounded-br-[calc(2rem+1px)]"] %}
{% set bentoImgH        = ["h-80", "h-80", "h-64", "h-64", "h-64"] %}
{% set bentoCapLen      = [160, 160, 120, 120, 120] %}

<section class="bg-glowyellowgreen-500 font-heading py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-8">

    <div class="flex items-center justify-between mb-10 sm:mb-16">
      <div>
        <p class="text-3xl font-subheading font-semibold text-night-bordeaux-500">{{ platformName }}</p>
        <h2 class="mt-2 text-2xl font-heading uppercase font-semibold tracking-tight text-pretty text-mauve-shadow-500 sm:text-2xl">Latest from : <span class="text-6xl">{{ platformHandle }}</span></h2>
      </div>
      <a href="{{ platformUrl }}" target="_blank" rel="noopener noreferrer"
         class="text-sm font-semibold text-{{ platformColor }}-600 hover:text-{{ platformColor }}-700">
        View all <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 md:grid-cols-6 md:grid-rows-2">
      {% for post in platformPosts %}
        {% if loop.index <= 5 %}
          <div class="relative {{ bentoSpan[loop.index0] }}">
            <div class="absolute inset-0 rounded-lg {% if post.type == 'status' %}bg-mauve-shadow-500{% else %}bg-seagrass-400{% endif %} {{ bentoOuterRound[loop.index0] }}"></div>

            <a href="{{ post.permalink }}" target="_blank" rel="noopener noreferrer"
               class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] {{ bentoInnerRound[loop.index0] }}">

              {% if post.type != 'status' %}
                {% if post.imageUrl %}
                  <img
                    src="{{ post.imageUrl }}"
                    alt="{{ post.text | truncate(80) }}"
                    class="{{ bentoImgH[loop.index0] }} w-full object-cover object-center"
                  />
                {% else %}
                  <div class="{{ bentoImgH[loop.index0] }} w-full bg-{{ platformColor }}-100 flex items-center justify-center">
                    <span class="text-{{ platformColor }}-300 text-6xl font-black select-none" aria-hidden="true">✦</span>
                  </div>
                {% endif %}
              {% endif %}

              <div class="p-6 pt-4 flex flex-col gap-2 {% if post.type == 'status' %}flex-1 justify-center{% endif %}">
                <span class="text-xs font-semibold {% if post.type == 'status' %}text-glowyellowgreen-400{% else %}text-{{ platformColor }}-600{% endif %} uppercase tracking-widest">{{ post.type }}</span>
                <p class="text-3xl {% if post.type == 'status' %}text-glowyellowgreen-500{% else %}text-gray-950{% endif %} line-clamp-5 ">{{ post.text | truncate(bentoCapLen[loop.index0]) }}</p>
                <p class="text-4xl {% if post.type == 'status' %}text-glowyellowgreen-700{% else %}text-glowyellowgreen-500{% endif %} mt-auto pt-2">{{ post.date | date("LLL d, yyyy") }}</p>
              </div>
            </a>

            <div class="pointer-events-none absolute inset-0 rounded-lg shadow-sm outline outline-black/5 {{ bentoOuterRound[loop.index0] }}"></div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% endif %}
