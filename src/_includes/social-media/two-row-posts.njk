{% if platformPosts and platformPosts.length > 5 %}

<div class="bg-mauve-shadow-500 font-heading pb-16 sm:pb-24 xl:pb-32">
  <div class=" py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 xl:gap-8">
        {% for post in platformPosts %}
          {% if loop.index > 5 and loop.index <= 15 %}

            <div class="flex flex-col gap-4">

              {# Post image or branded placeholder #}
              {% if post.type == 'status' %}
                <div class="relative aspect-square rounded-2xl bg-glowyellowgreen-500 flex items-center justify-center p-5 after:absolute after:inset-0 after:rounded-2xl after:inset-ring after:inset-ring-black/10">
                  <p class="text-sm/6 font-semibold text-mauve-shadow-700 text-center line-clamp-5">{{ post.text | truncate(150) or "(No caption)" }}</p>
                </div>
              {% elif post.imageUrl %}
                <div class="relative aspect-square overflow-hidden rounded-2xl after:absolute after:inset-0 after:rounded-2xl after:inset-ring after:inset-ring-white/15">
                  <img
                    src="{{ post.imageUrl }}"
                    alt="{{ post.text | truncate(60) }}"
                    class="absolute inset-0 size-full object-cover"
                  />
                </div>
              {% else %}
                <div class="relative aspect-square rounded-2xl bg-{{ platformColor }}-900 flex items-center justify-center after:absolute after:inset-0 after:rounded-2xl after:inset-ring after:inset-ring-white/15">
                  <span class="text-{{ platformColor }}-400 text-5xl select-none" aria-hidden="true">✦</span>
                </div>
              {% endif %}

              {# Caption as testimonial-style quote block #}
              <figure class="flex-1">
                <blockquote class="text-2xl font-thin {% if post.type == 'status' %}text-glowyellowgreen-500{% else %}text-white{% endif %} line-clamp-4">
                  <p>{{ post.text | truncate(150) or "(No caption)" }}</p>
                </blockquote>
                <figcaption class="mt-3 text-xs">
                  <div class="font-semibold {% if post.type == 'status' %}text-mauve-shadow-700{% else %}text-white{% endif %}">{{ platformHandle }}</div>
                  <div class="mt-1 {% if post.type == 'status' %}text-mauve-shadow-400{% else %}text-gray-400{% endif %}">{{ post.date | date("LLL d, yyyy") }}</div>
                </figcaption>
              </figure>

              <a
                href="{{ post.permalink }}"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold {% if post.type == 'status' %}text-mauve-shadow-500 hover:text-mauve-shadow-700{% else %}text-{{ platformColor }}-400 hover:text-{{ platformColor }}-300{% endif %}"
              >
                View post <span aria-hidden="true">→</span>
              </a>

            </div>

          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</div>

{% endif %}
