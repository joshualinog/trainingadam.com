{% if videos and videos.length %}
<section class="bg-[#376558] pt-24 sm:pt-32">
  <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
    <h2 class="flex items-center justify-center gap-2 text-center text-2xl font-subheading font-semibold text-night-bordeaux-500">Watch us on Youtube <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5 shrink-0"><path d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd" fill-rule="evenodd" /></svg></h2>
    <p class="mx-auto mt-2 max-w-lg text-center text-6xl font-heading font-semibold tracking-tight text-balance text-cotton-candy-400 sm:text-5xl uppercase">Our Latest Youtube Videos</p>

    <div class="mt-10 grid gap-4 sm:mt-16 lg:grid-cols-3 lg:grid-rows-2">

      {# Left tall card — videos[0] featured #}
      <div class="relative lg:row-span-2">
        <div class="absolute inset-px rounded-lg bg-seagrass-800 lg:rounded-l-4xl"></div>
        <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] lg:rounded-l-[calc(2rem+1px)]">
          {% if videos[0] %}
            <a href="{{ videos[0].url }}" target="_blank" rel="noopener noreferrer" class="group relative block min-h-80 flex-1 overflow-hidden lg:min-h-0">
              <img
                src="{{ videos[0].thumbnail }}"
                alt="{{ videos[0].title }}"
                class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-seagrass-900/90 via-seagrass-900/20 to-transparent"></div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity group-hover:opacity-100">
                <svg class="size-16 text-white drop-shadow-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7L8 5z"/>
                </svg>
              </div>
              <div class="absolute right-0 bottom-0 left-0 p-6">
                <time datetime="{{ videos[0].published }}" class="text-xs font-subheading text-glowyellowgreen-400">{{ videos[0].published | date("LLL d, yyyy") }}</time>
                <h3 class="mt-1 text-xl font-heading font-medium uppercase leading-tight text-white line-clamp-3">{{ videos[0].title }}</h3>
              </div>
            </a>
          {% endif %}
        </div>
        <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/10 lg:rounded-l-4xl"></div>
      </div>

      {# Middle top — videos[1] #}
      <div class="relative max-lg:row-start-1">
        <div class="absolute inset-px rounded-lg bg-seagrass-800 max-lg:rounded-t-4xl"></div>
        <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-t-[calc(2rem+1px)]">
          {% if videos[1] %}
            <a href="{{ videos[1].url }}" target="_blank" rel="noopener noreferrer" class="group relative block aspect-video overflow-hidden">
              <img
                src="{{ videos[1].thumbnail }}"
                alt="{{ videos[1].title }}"
                class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 transition-opacity group-hover:opacity-100">
                <svg class="size-10 text-white drop-shadow-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7L8 5z"/>
                </svg>
              </div>
            </a>
            <div class="flex flex-1 flex-col justify-center px-6 py-4">
              <time datetime="{{ videos[1].published }}" class="text-xs font-subheading text-glowyellowgreen-400">{{ videos[1].published | date("LLL d, yyyy") }}</time>
              <h3 class="mt-1 text-base font-heading font-medium uppercase leading-tight text-cotton-candy-400 line-clamp-2">{{ videos[1].title }}</h3>
            </div>
          {% endif %}
        </div>
        <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/10 max-lg:rounded-t-4xl"></div>
      </div>

      {# Middle bottom — videos[2] #}
      <div class="relative max-lg:row-start-3 lg:col-start-2 lg:row-start-2">
        <div class="absolute inset-px rounded-lg bg-seagrass-800"></div>
        <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)]">
          {% if videos[2] %}
            <a href="{{ videos[2].url }}" target="_blank" rel="noopener noreferrer" class="group relative block aspect-video overflow-hidden">
              <img
                src="{{ videos[2].thumbnail }}"
                alt="{{ videos[2].title }}"
                class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 transition-opacity group-hover:opacity-100">
                <svg class="size-10 text-white drop-shadow-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7L8 5z"/>
                </svg>
              </div>
            </a>
            <div class="flex flex-1 flex-col justify-center px-6 py-4">
              <time datetime="{{ videos[2].published }}" class="text-xs font-subheading text-glowyellowgreen-400">{{ videos[2].published | date("LLL d, yyyy") }}</time>
              <h3 class="mt-1 text-base font-heading font-medium uppercase leading-tight text-cotton-candy-400 line-clamp-2">{{ videos[2].title }}</h3>
            </div>
          {% endif %}
        </div>
        <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/10"></div>
      </div>

      {# Right tall card — videos[3] + CTA #}
      <div class="relative lg:row-span-2">
        <div class="absolute inset-px rounded-lg bg-seagrass-800 max-lg:rounded-b-4xl lg:rounded-r-4xl"></div>
        <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-b-[calc(2rem+1px)] lg:rounded-r-[calc(2rem+1px)]">
          {% if videos[3] %}
            <a href="{{ videos[3].url }}" target="_blank" rel="noopener noreferrer" class="group relative block min-h-80 flex-1 overflow-hidden lg:min-h-0">
              <img
                src="{{ videos[3].thumbnail }}"
                alt="{{ videos[3].title }}"
                class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-seagrass-900/90 via-seagrass-900/20 to-transparent"></div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity group-hover:opacity-100">
                <svg class="size-16 text-white drop-shadow-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7L8 5z"/>
                </svg>
              </div>
              <div class="absolute right-0 bottom-0 left-0 p-6">
                <time datetime="{{ videos[3].published }}" class="text-xs font-subheading text-glowyellowgreen-400">{{ videos[3].published | date("LLL d, yyyy") }}</time>
                <h3 class="mt-1 text-xl font-heading font-medium uppercase leading-tight text-white line-clamp-3">{{ videos[3].title }}</h3>
              </div>
            </a>
          {% endif %}
          <div class="shrink-0 p-6">
            <a
              href="/youtube-videos/"
              class="inline-block rounded-full bg-cotton-candy-400 px-8 py-3 text-base font-subheading font-semibold text-seagrass-700 transition-colors hover:bg-cotton-candy-300"
            >
              See all videos &rarr;
            </a>
          </div>
        </div>
        <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/10 max-lg:rounded-b-4xl lg:rounded-r-4xl"></div>
      </div>

    </div>
  </div>
  <img src="/assets/images/youtubebottom.png" alt="" class="w-full" aria-hidden="true" />
</section>
{% endif %}
