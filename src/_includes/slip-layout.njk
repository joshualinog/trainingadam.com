<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Darumadrop+One&family=Special+Elite&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    @page { size: 8.5in 11in; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { background: #e8e1d3; font-family: "Nunito Sans", system-ui, sans-serif; color: #581819; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .toolbar { display: flex; gap: 12px; justify-content: center; align-items: center; padding: 14px; flex-wrap: wrap; font-family: "Special Elite", serif; }
    .toolbar a, .toolbar button { font: inherit; font-weight: 700; border: 0; border-radius: 8px; padding: 10px 18px; cursor: pointer; text-decoration: none; }
    .toolbar .print { background: #458775; color: #fff; }
    .toolbar .back { background: #fff; color: #581819; }
    .toolbar span { font-size: 14px; }
    .sheet { width: 8.5in; height: 11in; margin: 0 auto 24px; background: #fffbf5; padding: 0.5in 0.6in; display: flex; flex-direction: column; box-shadow: 0 6px 24px rgba(0,0,0,.2); overflow: hidden; position: relative; }
    .sheet::before { content: ""; position: absolute; inset: 0.25in; border: 3px dashed #f14f22; border-radius: 18px; pointer-events: none; }
    header.slip { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
    .brand { font-family: "Special Elite", serif; font-size: 13pt; text-transform: uppercase; letter-spacing: .12em; color: #458775; }
    h1 { font-family: "Darumadrop One", serif; font-weight: 400; font-size: 40pt; line-height: 1; margin: 4px 0 0; color: #f14f22; }
    .branch { font-family: "Special Elite", serif; font-size: 13pt; margin-top: 6px; }
    .badge { width: 1.5in; height: 1.5in; flex: none; border-radius: 50%; background: #ffcb70; border: 4px solid #458775; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 56pt; }
    .badge img { width: 100%; height: 100%; object-fit: cover; }
    .item { margin-top: 0.2in; padding: 12px 16px; background: #fff; border: 2px solid #581819; border-radius: 12px; }
    .item h2 { margin: 0; font-family: "Special Elite", serif; font-size: 18pt; }
    .item p { margin: 4px 0 0; font-size: 11pt; line-height: 1.35; }
    .section-title { font-family: "Special Elite", serif; text-transform: uppercase; letter-spacing: .1em; font-size: 11pt; color: #458775; margin: 0.18in 0 0.05in; }
    .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.16in 0.3in; }
    .field { border-bottom: 1.5px solid #581819; padding-top: 0.22in; font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
    .field.full { grid-column: 1 / -1; }
    .checks { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 11pt; margin-top: 4px; }
    .checks span::before { content: ""; display: inline-block; width: 13px; height: 13px; border: 2px solid #581819; border-radius: 3px; margin-right: 7px; vertical-align: -2px; background: #fff; }
    .lines { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .lines div { flex: 1; border-bottom: 1.5px solid #581819; min-height: 0.3in; }
    footer.slip { margin-top: 0.15in; font-size: 9pt; line-height: 1.4; display: flex; justify-content: space-between; gap: 20px; align-items: flex-end; }
    .fineprint { margin-top: 0.1in; border-top: 1px solid #581819; padding-top: 5px; font-size: 6.8pt; line-height: 1.3; }
    .fineprint p { margin: 0 0 3px; }
    .thanks { margin: 4px 0 0; font-size: 8pt; text-align: center; }
    .sign { flex: 1; border-bottom: 1.5px solid #581819; padding-top: 0.3in; font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
    @media print {
      body { background: none; }
      .toolbar { display: none; }
      .sheet { margin: 0; box-shadow: none; page-break-after: avoid; }
    }
    @media screen and (max-width: 8.6in) {
      .sheet { transform-origin: top left; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button class="print" type="button" onclick="window.print()">Print or save as PDF</button>
    <a class="back" href="/#donation-wishlist">Back to the wishlist</a>
    <span>Set paper to Letter (8.5 × 11 in), margins: none.</span>
  </div>
  {{ content | safe }}
</body>
</html>
