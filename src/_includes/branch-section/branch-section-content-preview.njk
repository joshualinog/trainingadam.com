<div class="overflow-hidden  py-24 sm:py-32 ">
  <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
    <div class="max-w-4xl">
      <p class="text-2xl font-subheading text-{{ branch.colors.accent }}">This Initiative:</p>
      <h1 class="mt-2 text-4xl font-heading font-semibold tracking-tight text-pretty text-{{ branch.colors.mainHeading }} sm:text-5xl "> {{ branch.tagline }}</h1>
      <p class="mt-6 text-xl font-black  text-balance text-{{ branch.colors.mainHeading }}">{{ branch.description }}</p>
    </div>
    <section class="mt-20 grid grid-cols-1 lg:grid-cols-2 lg:gap-x-8 lg:gap-y-16">
      <div class="lg:pr-8">
        <h2 class="text-4xl uppercase font-hand font-black tracking-tight text-pretty text-{{ branch.colors.accent }}">Our Goal is {{ branch.missionTitle }}</h2>
        <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16">
          {% for feature in branch.branchFeatures %}
          <div class="relative pl-16">
            <dt class="text-base/7 font-semibold text-gray-900 text-white">
              <div class="absolute top-0 left-0 flex size-10 items-center justify-center rounded-lg bg-{{ branch.colors.mainHeading }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-{{ branch.colors.background }}">
                  <path d="{{ feature.icon }}" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <span class="font-subheading text-{{branch.colors.accent}} text-2xl">{{ feature.short }}</span>
            </dt>
            <dd class="mt-2 text-base/7  text-{{ branch.colors.mainHeading }} font-bold">{{ feature.description }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>
