          </div>
          <div class="-mt-8 aspect-square overflow-hidden rounded-xl shadow-xl outline-1 -outline-offset-1 outline-black/10 lg:-mt-40 shadow-none outline-white/10">
            <img src="https://picsum.photos/560/560" alt="" class="block size-full object-cover" />
          </div>
          <div class="aspect-square overflow-hidden rounded-xl shadow-xl outline-1 -outline-offset-1 outline-black/10 shadow-none outline-white/10">
            <img src="https://picsum.photos/560/560" alt="" class="block size-full object-cover" />
          </div>
          <div class="-mt-8 aspect-square overflow-hidden rounded-xl shadow-xl outline-1 -outline-offset-1 outline-black/10 lg:-mt-40 shadow-none outline-white/10">
            <img src="https://picsum.photos/560/560" alt="" class="block size-full object-cover" />
          </div>
        </div>
      </div> -->
      <div class="max-lg:mt-16 lg:col-span-1">
        <p class="text-6xl font-heading uppercase text-{{ branch.colors.accent }}">Our Number Goals</p>
        <hr class="mt-6 border-t border-gray-200 border-gray-700" />
        <dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
          <div class="flex flex-col gap-y-2 border-b border-dotted border-gray-200 pb-4 border-gray-700">
            <dt class="text-lg font-subheading font-semibold text-{{ branch.colors.accent}}">To Raise</dt>
            <dd class="order-first font-hand text-8xl font-semibold tracking-tight text-{{ branch.colors.mainHeading }}">$<span>{{ branch.stats.raised }}</span></dd>
          </div>
          <div class="flex flex-col gap-y-2 border-b border-dotted border-gray-200 pb-4 border-gray-700">
            <dt class="text-lg font-subheading font-semibold text-{{ branch.colors.accent}}">Company Sponsors</dt>
            <dd class="order-first font-hand text-8xl font-semibold tracking-tight text-{{ branch.colors.mainHeading }}"><span>{{ branch.stats.companies }}</span></dd>
          </div>
          <div class="flex flex-col gap-y-2 max-sm:border-b max-sm:border-dotted max-sm:border-gray-200 max-sm:pb-4 max-sm:border-gray-700">
            <dt class="text-lg font-subheading font-semibold text-{{ branch.colors.accent}}">Branches Completed</dt>
            <dd class="order-first font-hand text-8xl font-semibold tracking-tight text-{{ branch.colors.mainHeading }}"><span>{{ branch.stats.dealsClosed }}</span></dd>
          </div>
          <div class="flex flex-col gap-y-2">
            <dt class="text-lg font-subheading font-semibold text-{{ branch.colors.accent}}">Volunteers</dt>
            <dd class="order-first font-hand text-8xl font-semibold tracking-tight text-{{ branch.colors.mainHeading }}"><span>{{ branch.stats.leadsGenerated }}</span></dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</div>