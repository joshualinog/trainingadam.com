section id="branch-{{ branch.name | slug }}" class="bg-{{ branch.colors.background }} py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-4xl">
      <p class="text-sm uppercase tracking-[.35em] text-{{ branch.colors.accent }} font-subheading">Coming soon</p>
      <h2 class="mt-4 text-5xl font-heading font-semibold tracking-tight uppercase text-{{ branch.colors.mainHeading }} sm:text-6xl">{{ branch.name }}</h2>
      <p class="mt-6 text-xl leading-9 text-{{ branch.colors.body }}">{{ branch.description }}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {% for feature in branch.branchFeatures %}
      <div class="rounded-3xl border border-white/10 bg-white/10 p-6 shadow-lg backdrop-blur-sm">
        <p class="text-lg font-semibold text-{{ branch.colors.accent }}">{{ feature.short }}</p>
        <p class="mt-3 text-base leading-7 text-{{ branch.colors.body }}">{{ feature.description }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="mt-12 inline-flex items-center gap-3 rounded-full bg-{{ branch.colors.accent }} px-5 py-3 text-{{ branch.colors.contrast }} font-semibold shadow-sm">
      <span>Coming soon</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</section>
