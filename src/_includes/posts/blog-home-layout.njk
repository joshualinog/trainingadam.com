<div class="bg-cotton-candy-500 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:max-w-4xl">
      <h1 class="text-2xl sm:text-3xl font-heading font-semibold text-seagrass-700">Our Blog</h1>
      <p class="mt-2 max-w-lg text-5xl font-heading font-semibold tracking-tight text-pretty text-mauve-shadow-500 sm:text-8xl uppercase">Training Adam Blog</p>

      {% if pagedPosts and pagedPosts.length %}
        <div class="mt-16 space-y-20 lg:mt-20">
          {% for post in pagedPosts %}
            {% set postTags = post.data.tags or post.data.labels or [] %}
            {% set category = postTags[0] if postTags.length else 'Update' %}
            <article class="relative isolate flex flex-col gap-8 lg:flex-row">
              <div class="relative aspect-video sm:aspect-2/1 lg:aspect-square lg:w-64 lg:shrink-0">
                <img
                  src="{{ post.data.mainImage | default('https://picsum.photos/seed/' + (post.data.slug or loop.index) + '/1200/900') }}"
                  alt="{{ post.data.title }}"
                  class="absolute inset-0 size-full rounded-2xl bg-gray-50 object-cover dark:bg-gray-800"
                />
                <div class="absolute inset-0 rounded-2xl inset-ring inset-ring-gray-900/10 dark:inset-ring-white/10"></div>
              </div>

              <div>
                <div class="flex items-center gap-x-4 text-xs">
                  <time datetime="{{ post.data.date }}" class="font-subheading text-mauve-shadow-500">{{ post.data.date | date("LLL d, yyyy") }}</time>
                  <span class="relative z-10 rounded-full bg-seagrass-700 px-3 py-1.5 font-medium text-white">{{ category }}</span>
                </div>

                <div class="group relative max-w-xl">
                  <h2 class="mt-3 text-4xl font-heading font-medium tracking-tight text-mauve-shadow-500 uppercase">
                    <a href="{{ post.url }}">
                      <span class="absolute inset-0"></span>
                      {{ post.data.title }}
                    </a>
                  </h2>
                  <p class="mt-5 text-lg font-bold font-sans text-mauve-shadow-500">{{ post.data.excerpt | striptags | truncate(220) }}</p>
                </div>

                <div class="mt-6 flex border-t border-mauve-shadow-500/20 pt-6">
                  <div class="text-sm/6">
                    <a href="{{ post.data.raw_issue.url | default('/blog/') }}" class="font-subheading font-semibold text-mauve-shadow-500 hover:text-seagrass-700">{{ post.data.author | default('Training Adam') }}</a>
                  </div>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if pagination.pages.length > 1 %}
          <nav class="mt-16 border-t border-mauve-shadow-500/20 pt-6" aria-label="Pagination">
            <div class="flex items-center justify-center gap-2">
              {% for pageHref in pagination.hrefs %}
                {% set isCurrentPage = loop.index0 == pagination.pageNumber %}
                <a
                  href="{{ pageHref }}"
                  aria-current="{{ 'page' if isCurrentPage else 'false' }}"
                  class="rounded-md px-3 py-2 text-sm font-semibold {% if isCurrentPage %}bg-seagrass-600 text-white{% else %}bg-white text-mauve-shadow-500 shadow-sm ring-1 ring-mauve-shadow-500/30 hover:bg-night-bordeaux-50{% endif %}"
                >{{ loop.index }}</a>
              {% endfor %}
            </div>
          </nav>
        {% endif %}
      {% else %}
        <p class="mt-8 text-mauve-shadow-500">No posts yet.</p>
      {% endif %}
    </div>
  </div>
</div>
