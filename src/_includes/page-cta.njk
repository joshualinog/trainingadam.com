<section id="page-cta" class="bg-seagrass-500">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-4xl font-heading tracking-tight sm:text-5xl text-golden-pollen-500">{{ cta.heading }}</h2>
      {% if cta.text %}<p class="mt-6 text-lg/8 font-subheading text-white">{{ cta.text | safe }}</p>{% endif %}
    </div>
    <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:shrink-0">
      <a href="{{ cta.primary.href }}" {% if cta.primary.external %}target="_blank" rel="noopener noreferrer"{% endif %} class="rounded-md bg-blazing-flame-500 px-3.5 py-2.5 text-lg font-black font-subheading text-white shadow-xs hover:bg-blazing-flame-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blazing-flame-600">
        {{ cta.primary.label }}
      </a>
      {% if cta.secondary %}
      <a href="{{ cta.secondary.href }}" class="text-lg font-subheading font-black text-white hover:opacity-80">
        {{ cta.secondary.label }} <span aria-hidden="true">→</span>
      </a>
      {% endif %}
    </div>
  </div>
</section>
