<section id="donation-wishlist" class="bg-golden-pollen-50 py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6 lg:px-8">
    <div class="text-center">
      <p class="font-subheading text-lg uppercase tracking-widest text-seagrass-700">Stuff we'd love to receive</p>
      <h2 class="mt-2 font-heading text-4xl tracking-tight text-blazing-flame-500 sm:text-5xl">Things you can donate today</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-night-bordeaux-500">These are some ideas, but not a limit. Tap any item to learn more, or open a branch to see everything it needs.</p>
    </div>

    <ul role="list" class="mt-12 divide-y divide-night-bordeaux-500/10">
      {% for b in donationRows %}
      <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 py-5 sm:flex-nowrap">
        <div class="flex min-w-0 gap-x-4">
          {% if b.headingImage %}
          <img src="{{ b.headingImage }}" alt="" class="size-12 flex-none rounded-full bg-golden-pollen-100 object-cover" />
          {% elif b.emoji %}
          <span aria-hidden="true" class="flex size-12 flex-none items-center justify-center rounded-full bg-seagrass-100 text-2xl">{{ b.emoji }}</span>
          {% else %}
          <span class="flex size-12 flex-none items-center justify-center rounded-full bg-seagrass-100 font-heading text-xl text-seagrass-700">{{ loop.index }}</span>
          {% endif %}
          <div class="min-w-0 flex-auto">
            <p class="font-subheading text-base/6 font-semibold text-night-bordeaux-500">
              <a href="{{ b.url }}" class="hover:underline">{{ b.name }}</a>
            </p>
            <p class="mt-1 text-xs/5 text-night-bordeaux-500/70">{{ b.tagline }}</p>
            <p class="mt-1 text-xs/5"><a href="{{ b.generalSlipUrl }}" class="font-semibold text-blazing-flame-500 hover:underline">General donation slip</a></p>
          </div>
        </div>
        <dl class="flex w-full flex-none items-center justify-between gap-x-8 sm:w-auto">
          <div class="flex -space-x-0.5">
            <dt class="sr-only">Items you can donate</dt>
            {% for d in b.branchDonations %}
            {% set icon = donationIcons[d.image] or "🎁" %}
            <dd class="group relative">
              <button type="button"
                class="donation-item flex size-9 items-center justify-center overflow-hidden rounded-full bg-white text-lg outline-2 outline-golden-pollen-50 transition hover:z-10 hover:scale-110 hover:bg-seagrass-100 focus-visible:z-10 focus-visible:outline-seagrass-500"
                data-name="{{ d.name }}" data-short="{{ d.short }}" data-description="{{ d.description }}" data-icon="{{ icon }}" data-photo="{{ d.photo }}" data-branch="{{ b.name }}" data-branch-url="{{ b.url }}" data-slip="{{ d.slipUrl }}"
                aria-label="{{ d.name }} — {{ d.short }}">
                {% if d.photo %}<img src="{{ d.photo }}" alt="" class="size-full object-cover" />{% else %}<span aria-hidden="true">{{ icon }}</span>{% endif %}
              </button>
              <span role="tooltip" class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded-md bg-night-bordeaux-500 px-2.5 py-1 text-xs font-semibold text-white opacity-0 shadow-lg transition group-hover:opacity-100 group-focus-within:opacity-100">{{ d.name }}</span>
            </dd>
            {% endfor %}
          </div>
        </dl>
      </li>
      {% endfor %}
    </ul>

    <div class="mt-10 text-center">
      <a href="/donate" class="font-subheading text-lg font-semibold uppercase text-seagrass-700 hover:underline">Have something else to give? Tell us <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>

  <el-dialog>
    <dialog id="donation-dialog" aria-labelledby="donation-dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
      <el-dialog-backdrop class="fixed inset-0 bg-night-bordeaux-900/60 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
      <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
        <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-md sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
          <div>
            <a id="donation-dialog-slip" href="#" class="absolute right-4 top-4 z-10 font-heading text-xl text-blazing-flame-500 hover:underline sm:right-6 sm:top-5">Donation slip!</a>
            <div class="mx-auto mt-6 flex size-[300px] max-w-full items-center justify-center overflow-hidden rounded-full bg-golden-pollen-100 ring-4 ring-seagrass-500/30">
              <img id="donation-dialog-photo" src="" alt="" class="hidden size-full object-cover" />
              <span id="donation-dialog-icon" aria-hidden="true" class="text-[9rem] leading-none"></span>
            </div>
            <div class="mt-5 text-center">
              <p id="donation-dialog-branch" class="font-subheading text-sm uppercase tracking-widest text-seagrass-700"></p>
              <h3 id="donation-dialog-title" class="mt-1 font-heading text-3xl text-blazing-flame-500"></h3>
              <p id="donation-dialog-short" class="mt-1 font-semibold text-night-bordeaux-500"></p>
              <p id="donation-dialog-description" class="mt-3 text-sm text-night-bordeaux-500/80"></p>
            </div>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <a id="donation-dialog-branch-link" href="#" class="inline-flex justify-center rounded-md bg-golden-pollen-100 px-3 py-2 text-sm font-semibold text-night-bordeaux-500 hover:bg-golden-pollen-200">See this branch</a>
            <a href="/donate" class="inline-flex justify-center rounded-md bg-seagrass-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-seagrass-500">Donate this</a>
          </div>
          <button type="button" command="close" commandfor="donation-dialog" class="mt-3 inline-flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold text-night-bordeaux-500/70 hover:text-night-bordeaux-500">Close</button>
        </el-dialog-panel>
      </div>
    </dialog>
  </el-dialog>

  <script>
    (function () {
      var dialog = document.getElementById('donation-dialog');
      var $ = function (id) { return document.getElementById(id); };
      document.querySelectorAll('.donation-item').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var d = btn.dataset;
          $('donation-dialog-title').textContent = d.name;
          $('donation-dialog-short').textContent = d.short;
          $('donation-dialog-description').textContent = d.description;
          $('donation-dialog-branch').textContent = d.branch;
          $('donation-dialog-branch-link').href = d.branchUrl;
          $('donation-dialog-slip').href = d.slip;
          $('donation-dialog-icon').textContent = d.photo ? '' : d.icon;
          var photo = $('donation-dialog-photo');
          photo.classList.toggle('hidden', !d.photo);
          if (d.photo) { photo.src = d.photo; photo.alt = d.name; }
          dialog.showModal();
        });
      });
    })();
  </script>
</section>
