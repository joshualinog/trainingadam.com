<header class="absolute inset-x-0 top-0 z-50">
  <div class="mx-auto max-w-7xl">
    <div class="px-6 pt-6 lg:pr-0 lg:pl-8">
      <nav aria-label="Global" class="flex items-center justify-between lg:justify-start">
        <a href="/" class="-m-1.5 p-1.5">
          <span class="sr-only">Training Adam</span>
          <span class="text-xl font-heading text-olive-bark-900 uppercase">Training Adam</span>
        </a>
        <button type="button" command="show-modal" commandfor="mobile-menu" class="-m-2.5 rounded-md p-2.5 text-night-bordeaux-500 lg:hidden">
          <span class="sr-only">Open main menu</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
            <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="hidden lg:ml-12 lg:flex lg:items-center lg:gap-x-14">
          <a href="/#latest-posts" class="text-sm/6 font-subheading font-semibold text-night-bordeaux-500">Blog</a>
          <a href="/youtube-videos/" class="text-sm/6 font-subheading font-semibold text-night-bordeaux-500">Youtube</a>
          <a href="/#about-us" class="text-sm/6 font-subheading font-semibold text-night-bordeaux-500">About</a>

          {# ── Flyout ── #}
          <details id="initiatives-flyout" class="relative group">
            <summary class="flex cursor-pointer list-none items-center gap-x-1 text-sm/6 font-subheading font-semibold text-night-bordeaux-500 marker:hidden [&::-webkit-details-marker]:hidden">
              Initiatives
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 flex-none text-night-bordeaux-500 transition-transform group-open:rotate-180">
                <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
              </svg>
            </summary>

            <div class="absolute top-full -left-8 z-10 mt-4 w-screen max-w-md overflow-hidden rounded-3xl bg-golden-pollen-100 shadow-xl ring-1 ring-night-bordeaux-500/10">
              <div class="p-4">
                {% for b in branchPages %}{% if b.key != 'branch-data-schema' %}
                <div class="group/item relative flex items-center gap-x-6 rounded-lg p-4 text-sm/6 hover:bg-golden-pollen-200">
                  <div class="flex size-11 flex-none items-center justify-center rounded-lg bg-cotton-candy-300 group-hover/item:bg-seagrass-300">
                    <span class="font-heading text-xl text-night-bordeaux-500" aria-hidden="true">{{ b.name | first }}</span>
                  </div>
                  <div class="flex-auto">
                    <a href="{{ b.url }}" class="block font-subheading font-semibold text-night-bordeaux-500">
                      {{ b.name }}
                      <span class="absolute inset-0"></span>
                    </a>
                    <p class="mt-1 text-night-bordeaux-500/80">{{ b.tagline }}</p>
                  </div>
                </div>
                {% endif %}{% endfor %}
              </div>
              <div class="grid grid-cols-2 divide-x divide-night-bordeaux-500/10 bg-seagrass-500">
                <a href="/donate/" class="flex items-center justify-center gap-x-2.5 p-3 text-sm/6 font-subheading font-semibold text-white hover:bg-seagrass-600">Donate</a>
                <a href="/#contact" class="flex items-center justify-center gap-x-2.5 p-3 text-sm/6 font-subheading font-semibold text-white hover:bg-seagrass-600">Contact</a>
              </div>
            </div>
          </details>

          <a href="/donate/" class="text-sm/6 font-subheading font-semibold text-night-bordeaux-500">Donate</a>
          <a href="/#contact" class="text-sm/6 font-subheading font-semibold text-night-bordeaux-500">Contact</a>
        </div>
      </nav>
    </div>
  </div>

  <el-dialog>
    <dialog id="mobile-menu" class="backdrop:bg-transparent lg:hidden">
      <div tabindex="0" class="fixed inset-0 focus:outline-none">
        <el-dialog-panel class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-seagrass-500 p-6 sm:max-w-sm sm:ring-1 sm:ring-gray-100/10">
          <div class="flex items-center justify-between">
            <a href="/" class="-m-1.5 p-1.5">
              <span class="sr-only">Training Adam</span>
              <span class="text-5xl font-heading text-glowyellowgreen-500 uppercase">Training Adam</span>
            </a>
            <button type="button" command="close" commandfor="mobile-menu" class="flex items-center justify-center size-10 rounded-full bg-cotton-candy-500 text-white font-heading text-xl leading-none">
              <span class="sr-only">Close menu</span>
              <span aria-hidden="true">&#x2715;</span>
            </button>
          </div>
          <div class="mt-6 flow-root">
            <div class="-my-6 divide-y divide-white/10">
              <div class="space-y-2 py-6">
                <a href="/#latest-posts" class="-mx-3 block rounded-lg px-3 py-2 text-2xl font-subheading font-semibold text-white hover:bg-white/10">Blog</a>
                <a href="/youtube-videos/" class="-mx-3 block rounded-lg px-3 py-2 text-2xl font-subheading font-semibold text-white hover:bg-white/10">Youtube</a>
                <a href="/#about-us" class="-mx-3 block rounded-lg px-3 py-2 text-2xl font-subheading font-semibold text-white hover:bg-white/10">About</a>
                <a href="/donate/" class="-mx-3 block rounded-lg px-3 py-2 text-2xl font-subheading font-semibold text-white hover:bg-white/10">Donate</a>
                <a href="/#contact" class="-mx-3 block rounded-lg px-3 py-2 text-2xl font-subheading font-semibold text-white hover:bg-white/10">Contact</a>
              </div>
              <div class="space-y-2 py-6">
                <p class="px-3 font-subheading text-sm uppercase tracking-widest text-golden-pollen-300">Initiatives</p>
                {% for b in branchPages %}{% if b.key != 'branch-data-schema' %}
                <a href="{{ b.url }}" class="-mx-3 block rounded-lg px-3 py-2 text-xl font-subheading font-semibold text-white hover:bg-white/10">{{ b.name }}</a>
                {% endif %}{% endfor %}
              </div>
            </div>
          </div>
        </el-dialog-panel>
      </div>
    </dialog>
  </el-dialog>

  <script>
    (function () {
      var flyout = document.getElementById('initiatives-flyout');
      if (!flyout) return;
      document.addEventListener('click', function (e) {
        if (!flyout.contains(e.target)) flyout.removeAttribute('open');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') flyout.removeAttribute('open');
      });
    })();
  </script>
</header>
